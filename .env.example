# SGT EHS/Visitas Online (25d). Copie para .env e ajuste.

# Banco PostgreSQL do Online (próprio; não é o banco do SGT).
ONLINE_DB_USER=sgt_online
ONLINE_DB_PASSWORD=sgt_online
ONLINE_DB_NAME=sgt_online

# Base EXTERNA do Online usada na validação do `aud` do JWT do conector.
# IMPORTANTE: tem de ser IGUAL a SGT_ONLINE_URL configurado no conector do SGT
# (a URL que o conector de fato acessa). No compose do SGT (mesma máquina, Docker Desktop),
# use host.docker.internal para o conector alcançar este backend.
ONLINE_BASE_URL=http://host.docker.internal:8090

# Tempo mínimo de preenchimento do formulário (anti-bot, DEC §4/§11).
ONLINE_TEMPO_MINIMO=3s
